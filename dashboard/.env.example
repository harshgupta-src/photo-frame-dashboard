# Copy to .env.local (gitignored). Everything here is baked into the built dashboard.
VITE_FRAME_API=https://frame-data.<your-subdomain>.workers.dev
VITE_FRAME_KEY=<the Worker's READ_KEY secret>
VITE_HOME_LAT=43.6532
VITE_HOME_LON=-79.3832
# id:Name:#colour, comma separated. ids must match the Worker's CALENDARS secret.
# Keep the quotes: unquoted, everything from the first # is dropped as a comment.
VITE_PEOPLE="alex:Alex:#2D5BFF,jordan:Jordan:#E4007C"
VITE_DOG_NAME=Rex
VITE_PINNED_LIST=To-do
# Home Assistant (optional; set up on the frame, see kiosk/README.md). Adds a room lights button
# next to "All lights" on the Today screen: Name:entity pattern, * is a wildcard.
VITE_HA_ROOM=Living room:light.living_room_*
# Reminders from Home Assistant instead of the Worker when HA is set up on the frame (the Worker
# stays the fallback). See ha/README.md. VITE_HA_CALENDARS (calendar entity:person ids joined by +)
# also reads calendars from HA, but HA's CalDAV asks iCloud live and takes ~10s per calendar, so
# leaving it empty and using the Worker's cached calendars is usually better.
VITE_HA_CALENDARS=
VITE_HA_GROCERY=todo.grocery_list
VITE_HA_PINNED=todo.to_do
# Lines without the VITE_ prefix aren't baked into the dashboard: npm run deploy uploads them as
# Worker secrets instead (worker/scripts/deploy.mjs). Forward Shortcut pushes to HA (ha/README.md):
# HA_REMINDERS_WEBHOOK_URL=https://<ha external url>/api/webhook/<id>
# Dog walk log (WALKS.md): walks are kept in Lifelog; a read/write Lifelog token for the Worker.
# LIFELOG_URL=https://<your host>/lifelog
# LIFELOG_TOKEN=
# LIFELOG_WALK_TYPE=rex_walk
