# Copy to .env.local (gitignored). Everything here is baked into the built dashboard.
VITE_FRAME_API=https://frame-data.<your-subdomain>.workers.dev
VITE_FRAME_KEY=<the Worker's READ_KEY secret>
VITE_HOME_LAT=43.6532
VITE_HOME_LON=-79.3832
# id:Name:#colour, comma separated. ids must match the Worker's CALENDARS secret.
# Keep the quotes: unquoted, everything from the first # is dropped as a comment.
VITE_PEOPLE="alex:Alex:#2D5BFF,jordan:Jordan:#E4007C"
VITE_DOG_NAME=Rex
VITE_PINNED_LIST=To-do
# Home Assistant (optional; set up on the frame, see kiosk/README.md). Adds a room lights button
# next to "All lights" on the Today screen: Name:entity pattern, * is a wildcard.
VITE_HA_ROOM=Living room:light.living_room_*
