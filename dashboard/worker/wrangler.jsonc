// frame-data: calendar, Reminders and photo JSON for the frame, and the dashboard itself (../dist).
// Deploy from dashboard/: npm run deploy (builds the dashboard first, then deploys this Worker).
// Secrets (npx wrangler secret put NAME): ICLOUD_APPLE_ID, ICLOUD_APP_PASSWORD, READ_KEY, PUSH_TOKEN,
// PHOTO_ALBUM (iCloud Shared Album link with "Public Website" on).
// CALENDARS (JSON): {"Alex's Calendar": ["alex"], "Family": ["alex", "jordan"]}.
// Dog walk log (../WALKS.md): LIFELOG_URL, LIFELOG_TOKEN; optional LIFELOG_WALK_TYPE, WALK_CALENDAR, WALK_KEY.
// Agent calendar writes (src/agentcal.js): AGENT_CALENDARS; optional AGENT_CAL_KEY.
// Optional: HA_REMINDERS_WEBHOOK_URL (forward Shortcut pushes to Home Assistant, ../ha/README.md).
// npm run deploy also uploads any non-VITE_ KEY=value in ../.env.local as a secret (scripts/deploy.mjs).
// Local dev reads the same names from .dev.vars (gitignored; scripts/icloud-setup.mjs writes it).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "frame-data",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "DATA", "id": "978ca79b833f44e6881f8cd5fa24c47b" }],
  // The walk log's old Durable Object (WalkLog) was deleted in v2; walks are in Lifelog now.
  // Migrations are append-only history: keep both tags.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WalkLog"] },
    { "tag": "v2", "deleted_classes": ["WalkLog"] }
  ]
}
